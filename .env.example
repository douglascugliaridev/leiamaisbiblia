# Segredo usado para assinar o cookie de sessao (JWT).
# Gere um valor novo para cada instalacao:
#   openssl rand -base64 32
# NUNCA reuse o valor de outro ambiente: quem assina o token pode forjar sessao.
SESSION_SECRET=

# Caminho do arquivo SQLite. Padrao: ./data/leia-mais.db
# DATABASE_PATH=./data/leia-mais.db